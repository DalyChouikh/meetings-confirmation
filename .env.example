# Public (browser-safe)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SIGN_IN_ENABLED=false

# Server
LOG_LEVEL=info
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# System email (platform Gmail SMTP; local: Mailpit 127.0.0.1:44325, SMTP_REQUIRE_TLS=false)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REQUIRE_TLS=true

# Vercel system variables (set by Vercel when "Automatically expose System Environment Variables" is on;
# leave unset locally). Invite links may use these deployment URLs; anything else falls back to NEXT_PUBLIC_APP_URL.
VERCEL_URL=
VERCEL_BRANCH_URL=

# Google sign-in (Production + local only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# M4 meetings and sending
# Rollout flag until M4 ships (Preview, local, tests); Gmail connect only where tapnshow-web has the callback URI.
NEXT_PUBLIC_MEETINGS_ENABLED=
NEXT_PUBLIC_GMAIL_CONNECT_ENABLED=
# 32 random bytes, base64 (encrypts Gmail refresh tokens; rotating it breaks every stored connection)
GOOGLE_TOKEN_ENCRYPTION_KEY=
# 32 random bytes, base64url (personal links; rotating it invalidates every link already sent)
INVITE_TOKEN_SECRET=
# 32 random bytes, base64url (Supabase Cron -> /api/internal/dispatch)
DISPATCH_SECRET=
# Only e2e sets these (fake Gmail); production uses Google's defaults.
GMAIL_API_BASE_URL=
GOOGLE_OAUTH_TOKEN_URL=

# M7 Google Sheet: only e2e sets these (fake Sheets and Drive); production uses Google's defaults.
GOOGLE_SHEETS_API_BASE_URL=
GOOGLE_DRIVE_API_BASE_URL=

# Sentry (DSN is public; the rest are build-time only, set in Vercel)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
